{
  "name": "yx-bridge-mcp",
  "version": "1.0.0",
  "description": "MCP server that drives a Chromium browser (Yandex Browser, Chrome, Edge) through the YX Bridge extension: read open pages, manipulate DOM, run JS, screenshots, media, raw CDP, translation control, browser UI automation, and browsing statistics. 250+ tools.",
  "type": "module",
  "main": "src/server.js",
  "bin": { "yx-bridge-mcp": "src/server.js" },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "selftest": "node src/selftest.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "automation",
    "chromium",
    "yandex-browser",
    "chrome-extension",
    "cdp",
    "ai-agent",
    "web-scraping"
  ],
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ws": "^8.18.0"
  },
  "author": "MRsuperkosmos",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/superkosmosyt/yx-bridge" },
  "homepage": "https://github.com/superkosmosyt/yx-bridge#readme"
}
